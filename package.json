{
  "name": "iot-management",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "build": "pnpm -r build",
    "build:prod": "pnpm -r build",
    "db:migrate": "pnpm --filter @iot-management/api db:migrate",
    "dev:api": "pnpm --filter @iot-management/api dev",
    "dev:web": "pnpm --filter @iot-management/web-dashboard dev",
    "docker:build:api": "docker build -f apps/api/Dockerfile -t iot-management/api:local .",
    "docker:build:web": "docker build -f apps/web-dashboard/Dockerfile -t iot-management/web-dashboard:local .",
    "k8s:dry-run:local": "kubectl apply --dry-run=client -k deploy/kubernetes/overlays/local",
    "lint": "pnpm -r lint",
    "seed:demo": "pnpm --filter @iot-management/api seed:demo",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @iot-management/api test:e2e && pnpm --filter @iot-management/web-dashboard test:e2e",
    "validate:http-client": "node scripts/validate-http-client-suite.js"
  },
  "devDependencies": {
    "@iot-management/config": "workspace:*",
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2"
  }
}
